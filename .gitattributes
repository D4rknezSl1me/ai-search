# Normalize line endings so the repo is consistent across machines.
# Text files are stored with LF in the repo; Windows-only scripts keep CRLF.

* text=auto eol=lf

# Windows-native scripts
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Makefiles require tabs + LF
Makefile text eol=lf

# Binary / non-diffable
*.png   binary
*.jpg   binary
*.webp  binary
*.gz    binary
*.snapshot binary
