# Copy to .env and adjust. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=aisearch
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=aisearch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- NATS (JetStream) ---
NATS_HOST=nats
NATS_PORT=4222

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
# Required by OpenSearch 2.12+ even with security disabled for bootstrap
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Aisearch_dev_2026!

# --- MinIO ---
MINIO_ROOT_USER=aisearch
MINIO_ROOT_PASSWORD=change_me_in_env
MINIO_HOST=minio
MINIO_PORT=9000

# --- Text Embeddings Inference (GPU, 'gpu' profile) ---
TEI_HOST=tei
TEI_PORT=8080
EMBED_MODEL_ID=BAAI/bge-large-en-v1.5
EMBED_DIM=1024
# TEI image is arch-specific. Blackwell (RTX 50xx / sm_120) needs the blackwell
# build; Ampere/Ada use the default. Swap here without touching compose.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:blackwell-latest

# --- Cross-encoder re-ranker (GPU, 'gpu' profile) — optional, degrades to RRF ---
RERANK_HOST=reranker
RERANK_PORT=8085
# ms-marco-MiniLM (BERT) runs reliably on the TEI candle backend. The multilingual
# BAAI/bge-reranker-v2-m3 is preferred for recall but currently won't warm up on
# CPU candle / sm_120 GPU here — swap back once a stable backend is available.
RERANK_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Local synthesis LLM (Ollama, GPU, 'gpu' profile) — NO paid API ---
LLM_HOST=llm
LLM_PORT=11434
LLM_MODEL=llama3.1:8b

# --- Retrieval result cache (short TTL; skipped for fresh/news queries) ---
# Memoizes identical queries briefly so repeated/dashboard queries skip the
# embed+ANN+lexical+rerank work. Kept short so freshly-crawled docs surface fast.
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_S=60
RETRIEVAL_CACHE_SIZE=512

# --- Query understanding (LLM expansion/decomposition; recall-first) ---
# The local LLM rewrites each query into paraphrases + decomposed sub-questions,
# retrieved independently and RRF-fused. Off-path: if the LLM is down, retrieval
# falls back to the original query only. Set QUERY_EXPANSION=false to disable.
QUERY_EXPANSION=true
MAX_QUERY_EXPANSIONS=3
EXPANSION_TEMPERATURE=0.3
EXPANSION_TIMEOUT_S=20

# --- Freshness-aware ranking (blends recency into result ordering) ---
# Per-request freshness=auto|fresh|any controls the strength; these tune it.
# Recency score halves every N days; undated docs get a neutral weight (never
# buried for lacking a date). auto = gentle nudge, fresh = strong recency pull.
FRESHNESS_HALF_LIFE_DAYS=180
FRESHNESS_UNDATED_WEIGHT=0.5
FRESHNESS_AUTO_WEIGHT=0.15
FRESHNESS_FRESH_WEIGHT=0.45

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- AI service ---
AI_API_PORT=8000

# --- Crawler ---
CRAWLER_HEALTH_PORT=8090
CRAWLER_WORKERS=8
CRAWLER_MIN_DELAY_MS=800
CRAWLER_FETCH_TIMEOUT_S=15
CRAWLER_MAX_BODY_BYTES=5000000
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; ai-search/0.1)
# Recrawl scheduler: re-fetch FETCHED URLs last fetched more than N seconds ago,
# to keep the index fresh. 0 disables it. Batch caps re-enqueues per tick.
CRAWLER_RECRAWL_AFTER_S=0
CRAWLER_RECRAWL_BATCH=128
# Social freshness scheduler (Phase 3): re-ingests tracked (adapter, seed)
# entities on their per-entity cadence. TICK_S=0 turns the scheduler off; BATCH
# caps entities claimed per tick; SOCIAL_PACE_MS spaces successive fetches in a run.
CRAWLER_FRESHNESS_TICK_S=30
CRAWLER_FRESHNESS_BATCH=16
CRAWLER_SOCIAL_PACE_MS=500
MINIO_BUCKET=raw

# --- Browser render worker (Phase 3, 'app' profile) ---
# Claims render_queue jobs from the crawler and renders JS-heavy pages with
# Playwright/Chromium. CRAWLER_URL defaults to the in-network crawler service.
WORKER_HEALTH_PORT=8091
RENDER_BATCH=4
RENDER_CONCURRENCY=2
RENDER_NAV_TIMEOUT_MS=20000
RENDER_WAIT_UNTIL=networkidle
RENDER_SCROLL_PASSES=3
RENDER_BLOCK_RESOURCES=true
# Human-like pacing (post-load pause, mouse moves, jittered scroll dwell).
# Each render already gets a coherent rotated fingerprint; set false to shave
# latency where anti-bot pressure is low.
RENDER_HUMANIZE=true
# Session persistence: pin one identity + cookie jar per host and reuse it across
# renders (persisted to the sessionsdata volume, so warm/authenticated sessions
# survive restarts). Rotate a host's identity + jar once it exceeds the TTL.
RENDER_SESSIONS=true
RENDER_SESSION_DIR=/data/sessions
RENDER_SESSION_TTL_MS=86400000
# Proxy pool: distribute egress across the owner's OWN self-run proxies (NO paid
# provider — CLAUDE.md rule 2). A proxy is pinned per host so a warm session keeps
# a stable IP; a failing proxy backs off (capped exponential) and its hosts are
# repinned to a healthy one. Empty ⇒ direct connection.
#   RENDER_PROXIES: comma/newline list of scheme://[user:pass@]host:port entries.
#   RENDER_PROXY_FILE: optional path to a file with one proxy per line (# comments
#     ok); merged with RENDER_PROXIES. Mount it into the container (see compose).
RENDER_PROXIES=
RENDER_PROXY_FILE=
RENDER_PROXY_COOLDOWN_MS=30000
RENDER_PROXY_MAX_COOLDOWN_MS=300000
